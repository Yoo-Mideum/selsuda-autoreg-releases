{
  "manifest_version": 3,
  "name": "자동상품등록 프로그램 (자동후불사입 용) by 셀수다",
  "short_name": "자동상품등록",
  "version": "18.5.1",
  "description": "네이버 카탈로그 → 자동 상품등록 (AI 이미지·상세, 고시정보, 카탈로그 매칭)",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "power"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:*/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "자동상품등록 프로그램 열기 (자동후불사입 용) by 셀수다"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}